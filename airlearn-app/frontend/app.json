{
  "expo": {
    "name": "Raj Dharma Learn",
    "slug": "airlearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF9F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.rajdharma.airlearn",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for Speech Practice so you can record yourself pronouncing words."
      }
    },
    "android": {
      "package": "org.rajdharma.airlearn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF9F6"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-dev-client",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Raj Dharma Learn to use the microphone for speech practice.",
          "speechRecognitionPermission": "Allow Raj Dharma Learn to transcribe your speech during practice."
        }
      ],
      "./plugins/withAndroid12SplashIcon"
    ],
    "extra": {
      "eas": {
        "projectId": "870eea4d-2d23-41f1-9b6a-40a70c523802"
      }
    }
  }
}
